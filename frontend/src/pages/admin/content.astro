---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Conteúdo do site">
  <h1 class="mb-6 font-mono text-xl text-[var(--color-primary)]">~# conteúdo</h1>

  <form id="content-form" class="flex max-w-2xl flex-col gap-6">
    <fieldset class="flex flex-col gap-3">
      <legend class="mb-1 font-mono text-sm text-[var(--color-primary)]">hero — linhas do terminal</legend>
      <p class="text-xs text-[var(--color-text-dim)]">"cmd" é o comando digitado (ex: whoami) — não é traduzido.</p>
      <div id="hero-lines-list" class="flex flex-col gap-4"></div>
      <button id="hero-line-add" type="button" class="w-fit rounded border border-[var(--color-border)] px-3 py-1.5 font-mono text-xs text-[var(--color-primary)]">+ linha</button>
    </fieldset>

    <fieldset class="flex flex-col gap-3">
      <legend class="mb-1 font-mono text-sm text-[var(--color-primary)]">sobre</legend>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        heading (PT)
        <input id="field-about-heading-pt" type="text" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        heading (EN)
        <input id="field-about-heading-en" type="text" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        texto (PT)
        <textarea id="field-about-text-pt" rows="5" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]"></textarea>
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        texto (EN)
        <textarea id="field-about-text-en" rows="5" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]"></textarea>
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        comentário do bloco de código (PT)
        <input id="field-about-comment-pt" type="text" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 font-mono text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        comentário do bloco de código (EN)
        <input id="field-about-comment-en" type="text" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 font-mono text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        foco (PT)
        <input id="field-about-foco-pt" type="text" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        foco (EN)
        <input id="field-about-foco-en" type="text" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        formação (PT)
        <input id="field-about-formacao-pt" type="text" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        formação (EN)
        <input id="field-about-formacao-en" type="text" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
    </fieldset>

    <fieldset class="flex flex-col gap-3">
      <legend class="mb-1 font-mono text-sm text-[var(--color-primary)]">contato</legend>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        heading (PT)
        <input id="field-contact-heading-pt" type="text" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        heading (EN)
        <input id="field-contact-heading-en" type="text" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        texto (PT)
        <textarea id="field-contact-text-pt" rows="2" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]"></textarea>
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        texto (EN)
        <textarea id="field-contact-text-en" rows="2" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]"></textarea>
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        email
        <input id="field-contact-email" type="email" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
    </fieldset>

    <fieldset class="flex flex-col gap-3">
      <legend class="mb-1 font-mono text-sm text-[var(--color-primary)]">links</legend>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        CV (URL ou caminho, ex: /cv-matheus.pdf)
        <input id="field-cv-url" type="text" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        LinkedIn
        <input id="field-linkedin-url" type="url" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        GitHub
        <input id="field-github-url" type="url" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
    </fieldset>

    <fieldset class="flex flex-col gap-3">
      <legend class="mb-1 font-mono text-sm text-[var(--color-primary)]">rodapé</legend>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        direitos autorais (PT)
        <input id="field-footer-rights-pt" type="text" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-[var(--color-text)]">
        direitos autorais (EN)
        <input id="field-footer-rights-en" type="text" class="rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" />
      </label>
    </fieldset>

    <p id="form-error" class="hidden font-mono text-sm text-[var(--color-danger)]"></p>
    <p id="form-success" class="hidden font-mono text-sm text-[var(--color-success)]"></p>

    <div class="flex gap-3">
      <button type="submit" class="rounded border border-[var(--color-primary)] bg-[var(--color-primary)] px-4 py-2 font-mono text-sm text-[var(--color-bg)]" style="box-shadow: var(--glow);">salvar</button>
    </div>
  </form>
</AdminLayout>

<template id="hero-line-template">
  <div class="hero-line flex flex-col gap-2 rounded border border-[var(--color-border)] p-3">
    <div class="flex items-center justify-between">
      <label class="flex flex-1 flex-col gap-1 text-xs text-[var(--color-text-dim)]">
        cmd
        <input class="field-hero-cmd rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-2 py-1 font-mono text-sm text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" type="text" />
      </label>
      <button type="button" class="hero-line-remove ml-3 rounded border border-[var(--color-border)] px-2 py-1 font-mono text-xs text-[var(--color-danger)]">remover</button>
    </div>
    <label class="flex flex-col gap-1 text-xs text-[var(--color-text-dim)]">
      output (PT)
      <input class="field-hero-output-pt rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-2 py-1 text-sm text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" type="text" />
    </label>
    <label class="flex flex-col gap-1 text-xs text-[var(--color-text-dim)]">
      output (EN)
      <input class="field-hero-output-en rounded border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-2 py-1 text-sm text-[var(--color-text)] outline-none focus:border-[var(--color-primary)]" type="text" />
    </label>
  </div>
</template>

<script>
  import { adminFetch } from "../../lib/admin-api";

  interface HeroLineData {
    id?: number;
    position?: number;
    cmd: string;
    output_pt: string;
    output_en: string;
  }

  interface SiteContentAdmin {
    about_heading_pt: string; about_heading_en: string;
    about_text_pt: string; about_text_en: string;
    about_comment_pt: string; about_comment_en: string;
    about_foco_pt: string; about_foco_en: string;
    about_formacao_pt: string; about_formacao_en: string;
    contact_heading_pt: string; contact_heading_en: string;
    contact_text_pt: string; contact_text_en: string;
    contact_email: string;
    footer_rights_pt: string; footer_rights_en: string;
    cv_url: string; linkedin_url: string; github_url: string;
    hero_lines: HeroLineData[];
  }

  const FIELD_IDS: Array<keyof SiteContentAdmin> = [
    "about_heading_pt", "about_heading_en",
    "about_text_pt", "about_text_en",
    "about_comment_pt", "about_comment_en",
    "about_foco_pt", "about_foco_en",
    "about_formacao_pt", "about_formacao_en",
    "contact_heading_pt", "contact_heading_en",
    "contact_text_pt", "contact_text_en",
    "contact_email",
    "footer_rights_pt", "footer_rights_en",
    "cv_url", "linkedin_url", "github_url",
  ];

  function fieldEl(name: string): HTMLInputElement | HTMLTextAreaElement | null {
    return document.getElementById(`field-${name.replace(/_/g, "-")}`) as HTMLInputElement | HTMLTextAreaElement | null;
  }

  const form = document.getElementById("content-form") as HTMLFormElement | null;
  const errorEl = document.getElementById("form-error");
  const successEl = document.getElementById("form-success");
  const heroLinesList = document.getElementById("hero-lines-list");
  const heroLineTemplate = document.getElementById("hero-line-template") as HTMLTemplateElement | null;
  const addLineBtn = document.getElementById("hero-line-add");

  function addHeroLineRow(line: HeroLineData): void {
    if (!heroLinesList || !heroLineTemplate) return;
    const node = heroLineTemplate.content.cloneNode(true) as DocumentFragment;
    const wrap = node.querySelector<HTMLElement>(".hero-line");
    const cmdInput = node.querySelector<HTMLInputElement>(".field-hero-cmd");
    const outPtInput = node.querySelector<HTMLInputElement>(".field-hero-output-pt");
    const outEnInput = node.querySelector<HTMLInputElement>(".field-hero-output-en");
    const removeBtn = node.querySelector<HTMLButtonElement>(".hero-line-remove");

    if (cmdInput) cmdInput.value = line.cmd;
    if (outPtInput) outPtInput.value = line.output_pt;
    if (outEnInput) outEnInput.value = line.output_en;
    removeBtn?.addEventListener("click", () => wrap?.remove());

    heroLinesList.appendChild(node);
  }

  addLineBtn?.addEventListener("click", () => {
    addHeroLineRow({ cmd: "", output_pt: "", output_en: "" });
  });

  function collectHeroLines(): HeroLineData[] {
    return Array.from(document.querySelectorAll<HTMLElement>(".hero-line")).map((row) => ({
      cmd: row.querySelector<HTMLInputElement>(".field-hero-cmd")?.value ?? "",
      output_pt: row.querySelector<HTMLInputElement>(".field-hero-output-pt")?.value ?? "",
      output_en: row.querySelector<HTMLInputElement>(".field-hero-output-en")?.value ?? "",
    }));
  }

  async function load(): Promise<void> {
    const res = await adminFetch("/api/site-content/admin");
    if (!res.ok) {
      if (errorEl) {
        errorEl.textContent = "erro ao carregar conteúdo";
        errorEl.classList.remove("hidden");
      }
      return;
    }
    const data = (await res.json()) as SiteContentAdmin;
    FIELD_IDS.forEach((name) => {
      const el = fieldEl(name);
      if (el) el.value = String(data[name] ?? "");
    });
    data.hero_lines.forEach(addHeroLineRow);
  }

  void load();

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl?.classList.add("hidden");
    successEl?.classList.add("hidden");

    const payload: Record<string, unknown> = { hero_lines: collectHeroLines() };
    FIELD_IDS.forEach((name) => {
      payload[name] = fieldEl(name)?.value ?? "";
    });

    const res = await adminFetch("/api/site-content/admin", {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });

    if (!res.ok) {
      const data: unknown = await res.json().catch(() => null);
      const detail =
        data && typeof data === "object" && "detail" in data ? String((data as { detail: unknown }).detail) : null;
      if (errorEl) {
        errorEl.textContent = detail ?? "erro ao salvar";
        errorEl.classList.remove("hidden");
      }
      return;
    }

    if (successEl) {
      successEl.textContent = "salvo!";
      successEl.classList.remove("hidden");
    }
  });
</script>
