---
import "../styles/global.css";

interface Props {
  title: string;
  lang?: "pt" | "en";
}

const { title, lang = "pt" } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Se veio antes pra raiz ("/") e escolheu EN, manda pra /en/ direto.
      // Restrito à raiz pública: nunca mexe em /admin/* (sempre pt) nem em /en/
      // (que "força" EN só por o usuário ter navegado até lá, sem redirect de volta).
      if (location.pathname === "/" && localStorage.getItem("lang") === "en") {
        location.replace("/en/");
      }
    </script>
    <script is:inline>
      // Roda antes do primeiro paint: evita "flash" do tema errado no reload.
      const stored = localStorage.getItem("theme");
      const theme = stored === "light" || stored === "dark"
        ? stored
        : window.matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark"; // sem preferência salva/OS clara → dark é o padrão do site
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
