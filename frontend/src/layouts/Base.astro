---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: "pt" | "en";
  noindex?: boolean;
}

const {
  title,
  lang = "pt",
  noindex = false,
  description = lang === "en"
    ? "Fullstack developer & cybersecurity enthusiast — projects, skills and contact."
    : "Desenvolvedor fullstack & entusiasta de cybersecurity — projetos, skills e contato.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "pt_BR"} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      // Se veio antes pra raiz ("/") e escolheu EN, manda pra /en/ direto.
      // Restrito à raiz pública: nunca mexe em /admin/* (sempre pt) nem em /en/
      // (que "força" EN só por o usuário ter navegado até lá, sem redirect de volta).
      if (location.pathname === "/" && localStorage.getItem("lang") === "en") {
        location.replace("/en/");
      }
    </script>
    <script is:inline>
      // Roda antes do primeiro paint: evita "flash" do tema errado no reload.
      const stored = localStorage.getItem("theme");
      const theme = stored === "light" || stored === "dark"
        ? stored
        : window.matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark"; // sem preferência salva/OS clara → dark é o padrão do site
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Fallback pra navegadores sem animation-timeline: view() (a versão
      // nativa em CSS já cuida do reveal nos que suportam).
      if (!CSS.supports("animation-timeline: view()")) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 },
        );

        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
