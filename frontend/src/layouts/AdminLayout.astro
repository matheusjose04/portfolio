---
import Base from "./Base.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Base title={`Admin — ${title}`} lang="pt">
  <div class="flex min-h-screen flex-col md:flex-row">
    <aside class="flex shrink-0 flex-row items-center gap-4 border-b border-[var(--color-border)] p-4 md:w-52 md:flex-col md:items-stretch md:border-b-0 md:border-r">
      <p class="font-mono text-sm text-[var(--color-primary)] md:mb-6">matheus@admin:~$</p>
      <nav class="flex flex-1 flex-row gap-4 font-mono text-sm md:flex-col md:gap-2">
        <a href="/admin" class="text-[var(--color-text)] hover:text-[var(--color-primary)]">projetos</a>
        <a href="/admin/new" class="text-[var(--color-text)] hover:text-[var(--color-primary)]">+ novo</a>
        <button id="admin-logout" type="button" class="text-left text-[var(--color-text-dim)] hover:text-[var(--color-danger)]">
          sair
        </button>
      </nav>
    </aside>
    <main class="flex-1 p-6">
      <slot />
    </main>
  </div>
</Base>

<script>
  import { clearToken, getToken } from "../lib/admin-api";

  if (!getToken()) {
    window.location.href = "/admin/login";
  }

  document.getElementById("admin-logout")?.addEventListener("click", () => {
    clearToken();
    window.location.href = "/admin/login";
  });
</script>
