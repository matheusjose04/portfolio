---
import { languages, useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const lines = languages[lang].hero.terminal.lines;

const LINKEDIN_URL = "https://www.linkedin.com/in/matheuscasarin";
const GITHUB_URL = "https://github.com/matheusjose04";
const CV_URL = "/cv-matheus.pdf";
---

<section class="relative mx-auto max-w-6xl px-4 py-16 md:py-24" data-lang={lang}>
  <canvas id="matrix-rain" class="pointer-events-none absolute inset-0 z-10 hidden rounded-lg" aria-hidden="true"></canvas>
  <div class="grid gap-10 md:grid-cols-2 md:items-center">
    <div
      class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]"
      style="box-shadow: var(--glow);"
    >
      <div class="flex items-center gap-2 border-b border-[var(--color-border)] px-4 py-2">
        <span class="h-3 w-3 rounded-full bg-[var(--color-danger)]"></span>
        <span class="h-3 w-3 rounded-full bg-[var(--color-warning)]"></span>
        <span class="h-3 w-3 rounded-full bg-[var(--color-success)]"></span>
      </div>
      <pre
        id="terminal-body"
        class="min-h-40 whitespace-pre-wrap p-4 font-mono text-[13px] text-[var(--color-text)] md:text-[15px]"
      ><span id="terminal-text" data-lines={JSON.stringify(lines)} data-static-lines={JSON.stringify(
        lines.map((l) => `matheus@fullstack:~$ ${l.cmd}\n> ${l.output}`).join("\n\n")
      )}></span><span class="cursor-blink" aria-hidden="true">▋</span></pre>
    </div>

    <div class="flex flex-col items-center gap-6 md:items-start">
      <div class="grid h-[180px] w-[180px] place-items-center rounded-full border-[3px] border-[var(--color-primary)] bg-[var(--color-bg-soft)] transition-shadow hover:shadow-[var(--glow)]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="88" height="88" fill="none" stroke="var(--color-primary)" stroke-width="1.5">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7" />
        </svg>
      </div>

      <div class="flex flex-wrap justify-center gap-3 md:justify-start">
        <a
          id="hero-cv"
          href={CV_URL}
          download
          class="rounded border border-[var(--color-primary)] bg-[var(--color-primary)] px-4 py-2 font-mono text-sm text-[var(--color-bg)] transition hover:opacity-90"
          style="box-shadow: var(--glow);"
        >{t("hero.cta.cv")}</a>
        <a
          id="hero-linkedin"
          href={LINKEDIN_URL}
          target="_blank"
          rel="noopener"
          class="rounded border border-[var(--color-border)] px-4 py-2 font-mono text-sm text-[var(--color-text)] transition hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]"
        >{t("hero.cta.linkedin")}</a>
        <a
          id="hero-github"
          href={GITHUB_URL}
          target="_blank"
          rel="noopener"
          class="rounded border border-[var(--color-border)] px-4 py-2 font-mono text-sm text-[var(--color-text)] transition hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]"
        >{t("hero.cta.github")}</a>
      </div>
    </div>
  </div>
</section>

<script>
  interface TerminalLine {
    cmd: string;
    output: string;
  }

  interface SiteContent {
    cv_url: string;
    linkedin_url: string;
    github_url: string;
    hero_lines: TerminalLine[];
  }

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8000";
  const section = document.querySelector<HTMLElement>("section[data-lang]");
  const lang = section?.dataset.lang === "en" ? "en" : "pt";

  async function fetchSiteContent(): Promise<SiteContent | null> {
    try {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 1500);
      const res = await fetch(`${API_BASE}/api/site-content`, {
        headers: { "Accept-Language": lang },
        signal: controller.signal,
      });
      window.clearTimeout(timeout);
      if (!res.ok) return null;
      return (await res.json()) as SiteContent;
    } catch {
      return null;
    }
  }

  function applyLinks(content: SiteContent | null): void {
    if (!content) return;
    const cv = document.getElementById("hero-cv") as HTMLAnchorElement | null;
    const linkedin = document.getElementById("hero-linkedin") as HTMLAnchorElement | null;
    const github = document.getElementById("hero-github") as HTMLAnchorElement | null;
    if (cv && content.cv_url) cv.href = content.cv_url;
    if (linkedin && content.linkedin_url) linkedin.href = content.linkedin_url;
    if (github && content.github_url) github.href = content.github_url;
  }

  const PROMPT = "matheus@fullstack:~$ ";
  const textEl = document.getElementById("terminal-text");
  if (textEl) {
    void (async () => {
      const content = await fetchSiteContent();
      applyLinks(content);

      const linesRaw = textEl.dataset.lines;
      const fallbackLines: TerminalLine[] = linesRaw ? JSON.parse(linesRaw) : [];
      const lines: TerminalLine[] = content?.hero_lines?.length ? content.hero_lines : fallbackLines;
      const staticText =
        content?.hero_lines?.length
          ? lines.map((l) => `${PROMPT}${l.cmd}\n> ${l.output}`).join("\n\n")
          : textEl.dataset.staticLines ?? "";
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduced || lines.length === 0) {
      textEl.textContent = staticText;
    } else {
      let text = "";
      let lineIndex = 0;
      let charIndex = 0;
      let phase: "cmd" | "output" = "cmd";

      const tick = (): void => {
        if (lineIndex >= lines.length) {
          window.setTimeout(() => {
            text = "";
            lineIndex = 0;
            charIndex = 0;
            phase = "cmd";
            tick();
          }, 8000);
          return;
        }

        const line = lines[lineIndex];
        if (phase === "cmd") {
          const full = PROMPT + line.cmd;
          if (charIndex < full.length) {
            text += full[charIndex];
            charIndex += 1;
            textEl.textContent = text;
            window.setTimeout(tick, 50);
            return;
          }
          phase = "output";
          window.setTimeout(tick, 300);
          return;
        }

        text += `\n> ${line.output}\n\n`;
        textEl.textContent = text;
        lineIndex += 1;
        charIndex = 0;
        phase = "cmd";
        window.setTimeout(tick, 400);
      };

      tick();
      }
    })();
  }
</script>

<script>
  // Easter egg: código Konami (↑↑↓↓←→←→BA) dispara ~5s de "matrix rain" no hero.
  const KONAMI = [
    "ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown",
    "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight",
    "b", "a",
  ];
  let progress = 0;

  document.addEventListener("keydown", (e) => {
    const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    progress = key === KONAMI[progress] ? progress + 1 : key === KONAMI[0] ? 1 : 0;
    if (progress === KONAMI.length) {
      progress = 0;
      runMatrixRain();
    }
  });

  function runMatrixRain(): void {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const canvas = document.getElementById("matrix-rain") as HTMLCanvasElement | null;
    const section = canvas?.parentElement;
    if (!canvas || !section) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const rect = section.getBoundingClientRect();
    canvas.width = rect.width;
    canvas.height = rect.height;

    const fontSize = 16;
    const columns = Math.min(40, Math.floor(canvas.width / fontSize));
    const chars = "01アイウエオカキクケコサシスセソ";
    const drops = new Array(columns).fill(0);

    canvas.classList.remove("hidden");

    const interval = window.setInterval(() => {
      ctx.fillStyle = "rgba(5, 11, 20, 0.15)";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = "#38bdf8";
      ctx.font = `${fontSize}px monospace`;

      drops.forEach((y, i) => {
        const char = chars[Math.floor(Math.random() * chars.length)];
        const x = i * (canvas.width / columns);
        ctx.fillText(char, x, y * fontSize);
        drops[i] = y * fontSize > canvas.height && Math.random() > 0.975 ? 0 : y + 1;
      });
    }, 50);

    window.setTimeout(() => {
      window.clearInterval(interval);
      canvas.classList.add("hidden");
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }, 5000);
  }
</script>
