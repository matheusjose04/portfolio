---
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="projetos" class="mx-auto max-w-6xl px-4 py-16 md:py-24">
  <h2 class="mb-8 font-mono text-2xl text-[var(--color-primary)]">{t("projects.heading")}</h2>

  <div
    class="mb-6 flex flex-wrap gap-2"
    role="tablist"
    aria-label={t("a11y.projectsCategories")}
    data-lang={lang}
    data-error-text={t("projects.error")}
    data-empty-text={t("projects.empty")}
  >
    <button
      type="button"
      class="project-tab rounded border border-[var(--color-primary)] bg-[var(--color-surface)] px-3 py-1.5 font-mono text-xs text-[var(--color-primary)] transition data-[active=false]:border-[var(--color-border)] data-[active=false]:bg-transparent data-[active=false]:text-[var(--color-text-dim)]"
      data-category="complete"
      data-active="true"
      role="tab"
      aria-selected="true"
    >
      {t("projects.tabs.complete")} <span data-category-count="complete"></span>
    </button>
    <button
      type="button"
      class="project-tab rounded border border-[var(--color-border)] px-3 py-1.5 font-mono text-xs text-[var(--color-text-dim)] transition data-[active=true]:border-[var(--color-primary)] data-[active=true]:bg-[var(--color-surface)] data-[active=true]:text-[var(--color-primary)]"
      data-category="small"
      data-active="false"
      role="tab"
      aria-selected="false"
    >
      {t("projects.tabs.small")} <span data-category-count="small"></span>
    </button>
  </div>

  <div id="projects-status" class="mb-4 hidden items-center gap-3 font-mono text-sm text-[var(--color-text-dim)]">
    <span id="projects-status-text"></span>
    <button
      id="projects-retry"
      type="button"
      class="hidden rounded border border-[var(--color-border)] px-2 py-1 text-[var(--color-primary)] hover:border-[var(--color-primary)]"
    >{t("projects.retry")}</button>
  </div>

  <div id="projects-grid" class="reveal grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>

  <div
    id="project-modal-overlay"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4"
    data-open="false"
  >
    <div
      id="project-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="project-modal-title"
      class="max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]"
    >
      <div class="relative">
        <img id="project-modal-image" class="hidden aspect-video w-full object-cover" alt="" />
        <button
          id="project-modal-close"
          type="button"
          aria-label={t("a11y.close")}
          class="absolute right-3 top-3 grid h-9 w-9 place-items-center rounded border border-[var(--color-border)] bg-[var(--color-bg)]/80 text-[var(--color-text)] hover:border-[var(--color-primary)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="p-6">
        <p id="project-modal-category" class="mb-1 font-mono text-xs text-[var(--color-text-dim)]"></p>
        <h3 id="project-modal-title" class="mb-4 font-mono text-lg text-[var(--color-text)]"></h3>

        <p id="project-modal-description" class="mb-4 text-sm text-[var(--color-text)]"></p>

        <div class="mb-4 border-l-2 border-[var(--color-primary)] pl-3">
          <p class="mb-1 font-mono text-xs text-[var(--color-text-dim)]">{t("projects.modal.why")}</p>
          <p id="project-modal-why" class="text-sm text-[var(--color-text)]"></p>
        </div>

        <p class="mb-2 font-mono text-xs text-[var(--color-text-dim)]">{t("projects.modal.skillsUsed")}</p>
        <div id="project-modal-skills" class="mb-6 flex flex-wrap gap-2"></div>

        <div class="flex flex-wrap gap-3">
          <a
            id="project-modal-github"
            href="#"
            target="_blank"
            rel="noopener"
            class="hidden rounded border border-[var(--color-border)] px-4 py-2 font-mono text-sm text-[var(--color-text)] hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]"
          >{t("projects.modal.github")}</a>
          <a
            id="project-modal-demo"
            href="#"
            target="_blank"
            rel="noopener"
            class="hidden rounded border border-[var(--color-primary)] bg-[var(--color-primary)] px-4 py-2 font-mono text-sm text-[var(--color-bg)]"
            style="box-shadow: var(--glow);"
          >{t("projects.modal.demo")} ↗</a>
          <button
            id="project-modal-no-demo"
            type="button"
            disabled
            title={t("projects.modal.demoUnavailable")}
            class="hidden cursor-not-allowed rounded border border-[var(--color-border)] px-4 py-2 font-mono text-sm text-[var(--color-text-dim)]"
          >{t("projects.modal.demo")}</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { resolveFallback, type ApiProject } from "../data/fallback-projects";
  import { resolveImageUrl } from "../lib/image-url";
  import { skills } from "../data/skills";
  import type { Lang } from "../i18n/utils";

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8000";

  const tablist = document.querySelector<HTMLElement>('[role="tablist"][data-lang]');
  const lang: Lang = tablist?.dataset.lang === "en" ? "en" : "pt";
  const errorText = tablist?.dataset.errorText ?? "";
  const emptyText = tablist?.dataset.emptyText ?? "";

  const tabs = document.querySelectorAll<HTMLButtonElement>(".project-tab");
  const grid = document.getElementById("projects-grid");
  const statusEl = document.getElementById("projects-status");
  const statusTextEl = document.getElementById("projects-status-text");
  const retryBtn = document.getElementById("projects-retry");

  const overlay = document.getElementById("project-modal-overlay");
  const modal = document.getElementById("project-modal");
  const closeBtn = document.getElementById("project-modal-close");
  const imageEl = document.getElementById("project-modal-image") as HTMLImageElement | null;
  const categoryEl = document.getElementById("project-modal-category");
  const titleEl = document.getElementById("project-modal-title");
  const descriptionEl = document.getElementById("project-modal-description");
  const whyEl = document.getElementById("project-modal-why");
  const skillsWrapEl = document.getElementById("project-modal-skills");
  const githubLink = document.getElementById("project-modal-github") as HTMLAnchorElement | null;
  const demoLink = document.getElementById("project-modal-demo") as HTMLAnchorElement | null;
  const noDemoBtn = document.getElementById("project-modal-no-demo");

  let allProjects: ApiProject[] = [];
  let currentCategory = "complete";
  let lastFetchFailed = false;
  let lastFocused: HTMLElement | null = null;

  function skeletonCard(): HTMLDivElement {
    const card = document.createElement("div");
    card.className = "animate-pulse overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]";
    const img = document.createElement("div");
    img.className = "aspect-video bg-[var(--color-bg-soft)]";
    const body = document.createElement("div");
    body.className = "space-y-2 p-4";
    const line1 = document.createElement("div");
    line1.className = "h-4 w-2/3 rounded bg-[var(--color-bg-soft)]";
    const line2 = document.createElement("div");
    line2.className = "h-3 w-1/3 rounded bg-[var(--color-bg-soft)]";
    body.append(line1, line2);
    card.append(img, body);
    return card;
  }

  function renderSkeleton(): void {
    if (!grid) return;
    grid.innerHTML = "";
    for (let i = 0; i < 3; i += 1) {
      grid.appendChild(skeletonCard());
    }
  }

  function showStatus(text: string, withRetry: boolean): void {
    if (!statusEl || !statusTextEl || !retryBtn) return;
    statusTextEl.textContent = text;
    retryBtn.classList.toggle("hidden", !withRetry);
    statusEl.classList.remove("hidden");
    statusEl.classList.add("flex");
  }

  function hideStatus(): void {
    statusEl?.classList.add("hidden");
    statusEl?.classList.remove("flex");
  }

  function sortProjects(list: ApiProject[]): ApiProject[] {
    return [...list].sort((a, b) => Number(b.featured) - Number(a.featured));
  }

  function skillName(id: string): string {
    return skills.find((s) => s.id === id)?.name ?? id;
  }

  function createCard(project: ApiProject): HTMLButtonElement {
    const card = document.createElement("button");
    card.type = "button";
    card.className =
      "project-card group overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-left transition hover:-translate-y-1 hover:border-[var(--color-primary)] hover:shadow-[var(--glow)]";

    const imgWrap = document.createElement("div");
    imgWrap.className = "aspect-video overflow-hidden";
    const img = document.createElement("img");
    img.src = resolveImageUrl(project.image_url, API_BASE) ?? "/images/projects/placeholder-complete-1.svg";
    img.alt = project.title;
    img.loading = "lazy";
    img.className = "h-full w-full object-cover transition duration-300 group-hover:scale-105";
    imgWrap.appendChild(img);

    const body = document.createElement("div");
    body.className = "p-4";

    const title = document.createElement("h3");
    title.className = "mb-2 font-mono text-base text-[var(--color-text)]";
    title.textContent = project.title;

    const badgeWrap = document.createElement("div");
    badgeWrap.className = "flex flex-wrap gap-1.5";
    const shown = project.skills.slice(0, 3);
    const extra = project.skills.length - shown.length;
    shown.forEach((id) => {
      const badge = document.createElement("span");
      badge.className = "rounded border border-[var(--color-border)] px-2 py-0.5 font-mono text-xs text-[var(--color-text-dim)]";
      badge.textContent = skillName(id);
      badgeWrap.appendChild(badge);
    });
    if (extra > 0) {
      const more = document.createElement("span");
      more.className = "rounded border border-[var(--color-border)] px-2 py-0.5 font-mono text-xs text-[var(--color-text-dim)]";
      more.textContent = `+${extra}`;
      badgeWrap.appendChild(more);
    }

    body.append(title, badgeWrap);
    card.append(imgWrap, body);
    card.addEventListener("click", () => openModal(project, card));
    return card;
  }

  function updateCounts(): void {
    (["complete", "small"] as const).forEach((cat) => {
      const el = document.querySelector(`[data-category-count="${cat}"]`);
      if (el) el.textContent = String(allProjects.filter((p) => p.category === cat).length);
    });
  }

  function renderCurrentCategory(): void {
    if (!grid) return;
    const list = sortProjects(allProjects.filter((p) => p.category === currentCategory));
    grid.innerHTML = "";
    list.forEach((p) => grid.appendChild(createCard(p)));

    if (lastFetchFailed) {
      showStatus(errorText, true);
    } else if (list.length === 0) {
      showStatus(emptyText, false);
    } else {
      hideStatus();
    }
  }

  async function loadAll(): Promise<void> {
    renderSkeleton();
    hideStatus();
    try {
      const res = await fetch(`${API_BASE}/api/projects`, { headers: { "Accept-Language": lang } });
      if (!res.ok) throw new Error(`status ${res.status}`);
      allProjects = (await res.json()) as ApiProject[];
      lastFetchFailed = false;
    } catch {
      allProjects = resolveFallback(lang);
      lastFetchFailed = true;
    }
    updateCounts();
    renderCurrentCategory();
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((other) => {
        const active = other === tab;
        other.setAttribute("data-active", active ? "true" : "false");
        other.setAttribute("aria-selected", active ? "true" : "false");
      });
      currentCategory = tab.dataset.category ?? "complete";
      renderCurrentCategory();
    });
  });

  retryBtn?.addEventListener("click", () => {
    void loadAll();
  });

  function openModal(project: ApiProject, trigger: HTMLElement): void {
    if (
      !overlay || !modal || !imageEl || !categoryEl || !titleEl || !descriptionEl ||
      !whyEl || !skillsWrapEl || !githubLink || !demoLink || !noDemoBtn
    ) {
      return;
    }
    lastFocused = trigger;

    const modalImageSrc = resolveImageUrl(project.image_url, API_BASE);
    if (modalImageSrc) {
      imageEl.src = modalImageSrc;
      imageEl.alt = project.title;
      imageEl.classList.remove("hidden");
    } else {
      imageEl.classList.add("hidden");
    }

    categoryEl.textContent = project.category === "complete" ? "#complete-app" : "#small-project";
    titleEl.textContent = project.title;
    descriptionEl.textContent = project.description;
    whyEl.textContent = project.why;

    skillsWrapEl.innerHTML = "";
    project.skills.forEach((id) => {
      const badge = document.createElement("button");
      badge.type = "button";
      badge.className =
        "rounded border border-[var(--color-border)] px-2 py-1 font-mono text-xs text-[var(--color-primary)] hover:border-[var(--color-primary)]";
      badge.textContent = skillName(id);
      badge.addEventListener("click", () => {
        closeModal();
        window.dispatchEvent(new CustomEvent("skills:focus", { detail: { id } }));
        document.getElementById("skills")?.scrollIntoView({ behavior: "smooth" });
      });
      skillsWrapEl.appendChild(badge);
    });

    if (project.github_url) {
      githubLink.href = project.github_url;
      githubLink.classList.remove("hidden");
    } else {
      githubLink.classList.add("hidden");
    }

    if (project.demo_url) {
      demoLink.href = project.demo_url;
      demoLink.classList.remove("hidden");
      noDemoBtn.classList.add("hidden");
    } else {
      demoLink.classList.add("hidden");
      noDemoBtn.classList.remove("hidden");
    }

    overlay.dataset.open = "true";
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    document.body.style.overflow = "hidden";
    closeBtn?.focus();
  }

  function closeModal(): void {
    if (!overlay) return;
    overlay.dataset.open = "false";
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    document.body.style.overflow = "";
    lastFocused?.focus();
  }

  closeBtn?.addEventListener("click", closeModal);
  overlay?.addEventListener("click", (e) => {
    if (e.target === overlay) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (overlay?.dataset.open !== "true") return;
    if (e.key === "Escape") {
      closeModal();
      return;
    }
    if (e.key === "Tab" && modal) {
      const focusable = modal.querySelectorAll<HTMLElement>("button:not(:disabled), a[href]");
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  void loadAll();
</script>
