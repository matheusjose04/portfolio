---
import { useTranslations, type Lang } from "../i18n/utils";
import { devIconSvg } from "../lib/icon-url";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const LINKEDIN_URL = "https://www.linkedin.com/in/matheuscasarin";
const GITHUB_URL = "https://github.com/matheusjose04";
const EMAIL = t("contact.email");
const year = new Date().getFullYear();
---

<footer id="contato" class="border-t border-[var(--color-border)]" data-lang={lang}>
  <div class="reveal mx-auto max-w-6xl px-4 py-16 md:py-24">
    <h2 id="contact-heading" class="mb-4 font-mono text-2xl text-[var(--color-primary)]">{t("contact.heading")}</h2>
    <p id="contact-text" class="max-w-xl leading-relaxed text-[var(--color-text)]">{t("contact.text")}</p>
    <a
      id="contact-email-link"
      href={`mailto:${EMAIL}`}
      class="mt-6 inline-block rounded border border-[var(--color-primary)] bg-[var(--color-primary)] px-4 py-2 font-mono text-sm text-[var(--color-bg)] transition hover:opacity-90"
      style="box-shadow: var(--glow);"
    >{EMAIL}</a>
  </div>

  <div class="border-t border-[var(--color-border)]">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 py-8 font-mono text-xs text-[var(--color-text-dim)] md:flex-row md:justify-between">
      <p>© {year} matheus Casarin — <span id="footer-rights">{t("footer.rights")}</span></p>

      <div class="flex items-center gap-4">
        <a id="footer-github" href={GITHUB_URL} target="_blank" rel="noopener" aria-label="GitHub" class="hover:opacity-80">
          <img src={devIconSvg("devicon-github-original")} class="h-5 w-5" alt="" />
        </a>
        <a id="footer-linkedin" href={LINKEDIN_URL} target="_blank" rel="noopener" aria-label="LinkedIn" class="hover:opacity-80">
          <img src={devIconSvg("devicon-linkedin-plain")} class="h-5 w-5" alt="" />
        </a>
        <a id="footer-email" href={`mailto:${EMAIL}`} aria-label="Email" class="hover:text-[var(--color-primary)]">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </a>
      </div>

      <p>
        <span class="text-[var(--color-primary)]">matheus@fullstack:~$</span> exit 0
        <span class="text-[var(--color-text-dim)]"> (<span id="footer-exit">{t("footer.exit")}</span>)</span>
      </p>
    </div>
  </div>
</footer>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8000";
  const footer = document.querySelector<HTMLElement>("footer[data-lang]");
  const lang = footer?.dataset.lang === "en" ? "en" : "pt";

  interface SiteContent {
    contact_heading: string;
    contact_text: string;
    contact_email: string;
    footer_rights: string;
    linkedin_url: string;
    github_url: string;
  }

  async function hydrate(): Promise<void> {
    try {
      const res = await fetch(`${API_BASE}/api/site-content`, { headers: { "Accept-Language": lang } });
      if (!res.ok) return;
      const data = (await res.json()) as SiteContent;

      const headingEl = document.getElementById("contact-heading");
      const textEl = document.getElementById("contact-text");
      const emailLink = document.getElementById("contact-email-link") as HTMLAnchorElement | null;
      const rightsEl = document.getElementById("footer-rights");
      const githubLink = document.getElementById("footer-github") as HTMLAnchorElement | null;
      const linkedinLink = document.getElementById("footer-linkedin") as HTMLAnchorElement | null;
      const emailIconLink = document.getElementById("footer-email") as HTMLAnchorElement | null;

      if (headingEl) headingEl.textContent = data.contact_heading;
      if (textEl) textEl.textContent = data.contact_text;
      if (emailLink && data.contact_email) {
        emailLink.href = `mailto:${data.contact_email}`;
        emailLink.textContent = data.contact_email;
      }
      if (emailIconLink && data.contact_email) emailIconLink.href = `mailto:${data.contact_email}`;
      if (rightsEl) rightsEl.textContent = data.footer_rights;
      if (githubLink && data.github_url) githubLink.href = data.github_url;
      if (linkedinLink && data.linkedin_url) linkedinLink.href = data.linkedin_url;
    } catch {
      // API offline: mantém o conteúdo estático já renderizado.
    }
  }

  void hydrate();
</script>
