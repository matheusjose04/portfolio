---
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const paragraphs = t("about.text").split("\n\n");
---

<section id="sobre" class="mx-auto max-w-6xl px-4 py-16 md:py-24" data-lang={lang}>
  <h2 id="about-heading" class="mb-8 font-mono text-2xl text-[var(--color-primary)]">{t("about.heading")}</h2>
  <div class="grid gap-10 md:grid-cols-2 md:items-start">
    <div id="about-paragraphs" class="reveal space-y-4 leading-relaxed text-[var(--color-text)]">
      {paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <div class="reveal rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-5 font-mono text-sm leading-relaxed">
      <p id="about-comment" class="text-[var(--color-text-dim)]">{t("about.decoration.comment")}</p>
      <p class="text-[var(--color-text)]">
        <span class="text-[var(--color-accent)]">const</span> dev = {"{"}
      </p>
      <p class="pl-4 text-[var(--color-text)]">
        foco: <span id="about-foco" class="text-[var(--color-primary)]">"{t("about.decoration.foco")}"</span>,
      </p>
      <p class="pl-4 text-[var(--color-text)]">
        formacao: <span id="about-formacao" class="text-[var(--color-primary)]">"{t("about.decoration.formacao")}"</span>,
      </p>
      <p class="text-[var(--color-text)]">{"}"};</p>
    </div>
  </div>
</section>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8000";
  const section = document.querySelector<HTMLElement>("#sobre[data-lang]");
  const lang = section?.dataset.lang === "en" ? "en" : "pt";

  interface SiteContent {
    about_heading: string;
    about_text: string;
    about_comment: string;
    about_foco: string;
    about_formacao: string;
  }

  async function hydrate(): Promise<void> {
    try {
      const res = await fetch(`${API_BASE}/api/site-content`, { headers: { "Accept-Language": lang } });
      if (!res.ok) return;
      const data = (await res.json()) as SiteContent;

      const headingEl = document.getElementById("about-heading");
      const paragraphsEl = document.getElementById("about-paragraphs");
      const commentEl = document.getElementById("about-comment");
      const focoEl = document.getElementById("about-foco");
      const formacaoEl = document.getElementById("about-formacao");

      if (headingEl) headingEl.textContent = data.about_heading;
      if (paragraphsEl) {
        paragraphsEl.innerHTML = "";
        data.about_text.split("\n\n").forEach((paragraph) => {
          const p = document.createElement("p");
          p.textContent = paragraph;
          paragraphsEl.appendChild(p);
        });
      }
      if (commentEl) commentEl.textContent = data.about_comment;
      if (focoEl) focoEl.textContent = `"${data.about_foco}"`;
      if (formacaoEl) formacaoEl.textContent = `"${data.about_formacao}"`;
    } catch {
      // API offline: mantém o conteúdo estático já renderizado.
    }
  }

  void hydrate();
</script>
