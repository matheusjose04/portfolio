---
import { skills as staticSkills, type SkillCategory } from "../data/skills";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categories: Array<{ id: SkillCategory; label: string }> = [
  { id: "languages", label: t("skills.categories.languages") },
  { id: "databases", label: t("skills.categories.databases") },
  { id: "frameworks", label: t("skills.categories.frameworks") },
  { id: "tools", label: t("skills.categories.tools") },
];
---

<section id="skills" class="mx-auto max-w-6xl px-4 py-16 md:py-24">
  <h2 class="mb-8 font-mono text-2xl text-[var(--color-primary)]">{t("skills.heading")}</h2>

  <div class="mb-8 flex flex-wrap gap-2" role="tablist" aria-label={t("a11y.skillsCategories")}>
    {categories.map((cat, i) => (
      <button
        type="button"
        class="skill-tab rounded border border-[var(--color-border)] px-3 py-1.5 font-mono text-xs uppercase tracking-wide text-[var(--color-text-dim)] transition data-[active=true]:border-[var(--color-primary)] data-[active=true]:bg-[var(--color-surface)] data-[active=true]:text-[var(--color-primary)]"
        data-category={cat.id}
        data-active={i === 0 ? "true" : "false"}
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
      >{cat.label}</button>
    ))}
  </div>

  <div
    id="skills-grid"
    class="reveal grid gap-4"
    style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));"
    data-lang={lang}
    data-fallback={JSON.stringify(staticSkills)}
  ></div>

  <div
    id="skill-modal-overlay"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4"
    data-open="false"
    data-level-prefix={t("skills.modal.level")}
  >
    <div
      id="skill-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="skill-modal-title"
      class="w-full max-w-md rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-6"
    >
      <div class="mb-4 flex items-start justify-between gap-4">
        <div class="flex items-center gap-3">
          <img id="skill-modal-icon" class="h-10 w-10" alt="" />
          <h3 id="skill-modal-title" class="font-mono text-lg text-[var(--color-text)]"></h3>
        </div>
        <button
          id="skill-modal-close"
          type="button"
          aria-label={t("a11y.close")}
          class="rounded border border-[var(--color-border)] p-1 text-[var(--color-text)] hover:border-[var(--color-primary)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="mb-4">
        <p id="skill-modal-level-text" class="mb-1 font-mono text-xs text-[var(--color-text-dim)]"></p>
        <span class="block h-2 w-full overflow-hidden rounded-full bg-[var(--color-bg-soft)]">
          <span id="skill-modal-level-bar" class="block h-full w-0 rounded-full bg-[var(--color-primary)] transition-[width] duration-[600ms]"></span>
        </span>
      </div>

      <p id="skill-modal-summary" class="mb-3 text-sm text-[var(--color-text)]"></p>
      <p id="skill-modal-experience" class="mb-4 text-sm text-[var(--color-text-dim)]"></p>

      <a id="skill-modal-link" href="#projetos" class="font-mono text-sm text-[var(--color-primary)] hover:underline">
        {t("skills.modal.projectsLink")}
      </a>
    </div>
  </div>
</section>

<script>
  import { devIconSvg } from "../lib/icon-url";

  interface Skill {
    id: string;
    category: string;
    name: string;
    icon: string;
    level: number;
    levelLabel: { pt: string; en: string };
    summary: { pt: string; en: string };
    experience: { pt: string; en: string };
  }

  interface ApiSkill {
    skill_id: string;
    category: string;
    name: string;
    icon: string;
    level: number;
    level_label: { pt: string; en: string };
    summary: { pt: string; en: string };
    experience: { pt: string; en: string };
  }

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8000";

  const grid = document.getElementById("skills-grid");
  const lang = grid?.dataset.lang === "en" ? "en" : "pt";
  const fallbackSkills: Skill[] = grid?.dataset.fallback ? JSON.parse(grid.dataset.fallback) : [];

  const tabs = document.querySelectorAll<HTMLButtonElement>(".skill-tab");
  const overlay = document.getElementById("skill-modal-overlay");
  const modal = document.getElementById("skill-modal");
  const closeBtn = document.getElementById("skill-modal-close");
  const titleEl = document.getElementById("skill-modal-title");
  const iconEl = document.getElementById("skill-modal-icon");
  const levelTextEl = document.getElementById("skill-modal-level-text");
  const levelBarEl = document.getElementById("skill-modal-level-bar");
  const summaryEl = document.getElementById("skill-modal-summary");
  const experienceEl = document.getElementById("skill-modal-experience");
  const levelPrefix = overlay?.dataset.levelPrefix ?? "";

  let lastFocused: HTMLElement | null = null;
  let currentCategory = "languages";

  function apiToSkill(s: ApiSkill): Skill {
    return {
      id: s.skill_id,
      category: s.category,
      name: s.name,
      icon: s.icon,
      level: s.level,
      levelLabel: s.level_label,
      summary: s.summary,
      experience: s.experience,
    };
  }

  function openModal(skill: Skill, trigger: HTMLElement): void {
    if (!overlay || !modal || !iconEl || !titleEl || !levelTextEl || !levelBarEl || !summaryEl || !experienceEl) {
      return;
    }
    lastFocused = trigger;

    (iconEl as HTMLImageElement).src = devIconSvg(skill.icon);
    titleEl.textContent = skill.name;
    levelTextEl.textContent = `${levelPrefix}: ${skill.levelLabel[lang]}`;
    summaryEl.textContent = skill.summary[lang];
    experienceEl.textContent = skill.experience[lang];

    overlay.dataset.open = "true";
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    document.body.style.overflow = "hidden";

    levelBarEl.style.width = "0%";
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        levelBarEl.style.width = `${(skill.level / 5) * 100}%`;
      });
    });

    closeBtn?.focus();
  }

  function closeModal(): void {
    if (!overlay) return;
    overlay.dataset.open = "false";
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    document.body.style.overflow = "";
    lastFocused?.focus();
  }

  function createCard(skill: Skill): HTMLButtonElement {
    const card = document.createElement("button");
    card.type = "button";
    card.className =
      "skill-card flex cursor-pointer flex-col items-center gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-4 text-center transition hover:-translate-y-1 hover:border-[var(--color-primary)] hover:shadow-[var(--glow)]";
    card.dataset.category = skill.category;
    card.dataset.skillId = skill.id;

    const icon = document.createElement("img");
    icon.className = "h-8 w-8";
    icon.src = devIconSvg(skill.icon);
    icon.alt = "";

    const name = document.createElement("span");
    name.className = "font-mono text-sm text-[var(--color-text)]";
    name.textContent = skill.name;

    const barWrap = document.createElement("span");
    barWrap.className = "h-1 w-full overflow-hidden rounded-full bg-[var(--color-bg-soft)]";
    const bar = document.createElement("span");
    bar.className = "block h-full rounded-full bg-[var(--color-primary)]";
    bar.style.width = `${(skill.level / 5) * 100}%`;
    barWrap.appendChild(bar);

    card.append(icon, name, barWrap);
    card.style.display = skill.category === currentCategory ? "" : "none";
    card.addEventListener("click", () => openModal(skill, card));
    return card;
  }

  function renderSkills(list: Skill[]): void {
    if (!grid) return;
    grid.innerHTML = "";
    list.forEach((skill) => grid.appendChild(createCard(skill)));
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((other) => {
        const active = other === tab;
        other.setAttribute("data-active", active ? "true" : "false");
        other.setAttribute("aria-selected", active ? "true" : "false");
      });
      currentCategory = tab.dataset.category ?? "languages";
      document.querySelectorAll<HTMLButtonElement>(".skill-card").forEach((card) => {
        card.style.display = card.dataset.category === currentCategory ? "" : "none";
      });
    });
  });

  closeBtn?.addEventListener("click", closeModal);

  overlay?.addEventListener("click", (e) => {
    if (e.target === overlay) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (overlay?.dataset.open !== "true") return;

    if (e.key === "Escape") {
      closeModal();
      return;
    }

    if (e.key === "Tab" && modal) {
      const focusable = modal.querySelectorAll<HTMLElement>("button, a[href]");
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Disparado pelo ProjectModal ao clicar numa badge de skill: troca pra
  // aba certa e dá um destaque temporário no card correspondente.
  window.addEventListener("skills:focus", (e) => {
    const id = (e as CustomEvent<{ id: string }>).detail?.id;
    if (!id) return;
    const card = document.querySelector<HTMLButtonElement>(`.skill-card[data-skill-id="${id}"]`);
    if (!card) return;

    const category = card.dataset.category;
    const targetTab = Array.from(tabs).find((tab) => tab.dataset.category === category);
    targetTab?.click();

    card.scrollIntoView({ block: "center" });
    card.classList.add("outline", "outline-2", "outline-[var(--color-primary)]");
    window.setTimeout(() => {
      card.classList.remove("outline", "outline-2", "outline-[var(--color-primary)]");
    }, 1500);
  });

  async function loadSkills(): Promise<void> {
    renderSkills(fallbackSkills);
    try {
      const res = await fetch(`${API_BASE}/api/skills`);
      if (!res.ok) throw new Error(`status ${res.status}`);
      const items = (await res.json()) as ApiSkill[];
      if (items.length > 0) {
        renderSkills(items.map(apiToSkill));
      }
    } catch {
      // API offline: mantém os cards estáticos já renderizados.
    }
  }

  void loadSkills();
</script>
